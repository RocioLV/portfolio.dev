---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className = "" } = Astro.props;
---

<section
  id={id}
  data-section={id}
  class:list={["section-container", className]}
>
  <slot />
</section>

<style>
  .section-container {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    scroll-margin-top: 110px;
    background: transparent;
  }
</style>
