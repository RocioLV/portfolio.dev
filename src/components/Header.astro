---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { title: "Sobre mí", url: "/#sobre-mi" },
  { title: "Proyectos", url: "/#proyectos" },
  { title: "Experiencia", url: "/#experiencia" },
  { title: "Contacto", url: "mailto:lorcavillalobos@gmail.com" },
];
---

<header class="site-header">
  <nav class="site-nav" aria-label="Navegación principal">
    <a href="/" class="site-logo" aria-label="Inicio">
      <span class="logo-mark">RL<span>.</span></span>
      <span class="logo-label">Rocío Lorca</span>
    </a>

    <div class="nav-links">
      {
        navItems.map((item) => (
          <a href={item.url} class="nav-link">
            {item.title}
          </a>
        ))
      }
    </div>

    <div class="nav-actions">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    padding: 14px 24px;
    background: #191423;
    border: 0;
    box-shadow: none;
  }

  .site-nav {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-mark {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.08em;
    color: #f0eafe;
  }

  .logo-mark span {
    color: #ff825b;
  }

  .logo-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: #f0eafe;
  }

  .nav-links,
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    color: #d6cde5;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #ff825b;
  }

  .site-header :global(a:focus-visible) {
    outline: 2px solid #ff825b;
    outline-offset: 5px;
    border-radius: 4px;
  }

  @media (max-width: 760px) {
    .site-header {
      padding: 12px 16px;
    }

    .site-nav {
      flex-wrap: wrap;
      gap: 10px;
    }

    .logo-label {
      display: none;
    }

    .nav-links {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 10px;
    }

    .nav-link {
      font-size: 0.77rem;
    }

    .nav-actions {
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }
</style>
