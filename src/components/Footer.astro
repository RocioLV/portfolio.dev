
---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Volver al inicio">
        RL<span>.</span>
      </a>

      <p>
        Diseñado y desarrollado por Rocío Lorca.
      </p>
    </div>

    <nav class="footer-links" aria-label="Navegación del pie de página">
      <a href="/#proyectos">Proyectos</a>
      <a href="/#sobre-mi">Sobre mí</a>
      <a href="/#contacto">Contacto</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <span>© {currentYear} Rocío Lorca Villalobos</span>
    <span>Hecho con Astro y un poco de creatividad <span aria-hidden="true">✳</span></span>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding: 36px 24px 26px;
    border-top: 1px solid rgba(185, 152, 231, 0.16);
    background: rgba(15, 11, 23, 0.45);
    color: #f0eafe;
  }

  .footer-inner,
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    max-width: 1120px;
    margin-inline: auto;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .footer-logo {
    color: #f0eafe;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.08em;
    text-decoration: none;
  }

  .footer-logo span {
    color: #ff825b;
  }

  .footer-brand p {
    color: #bdb1cc;
    font-size: 0.81rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-links a {
    color: #c9bdd7;
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #ff825b;
  }

  .footer-bottom {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid rgba(240, 234, 254, 0.08);
    color: #9f92b1;
    font-size: 0.74rem;
  }

  .footer-bottom span span {
    color: #ff825b;
  }

  .site-footer a:focus-visible {
    outline: 2px solid #ff825b;
    outline-offset: 4px;
  }

  @media (max-width: 680px) {
    .site-footer {
      padding-inline: 16px;
    }

    .footer-inner,
    .footer-bottom,
    .footer-brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .footer-links {
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links a {
      transition: none;
    }
  }
</style>
