---
import TechBadge from "./TechBadge.astro";
interface Project {
  title: string;
  category: string;
  description: string;
  technologies: string[];
  image?: string;
  demo?: string;
  github?: string;
  featured?: boolean;
}

const projects: Project[] = [
  {
    title: "FLICK — Movie Discovery App",
    category: "FRONTEND · API INTEGRATION",
    description:
      "Aplicación de exploración de películas desarrollada con React y TypeScript. Incluye búsqueda, filtros, paginación y modales accesibles. Integra TMDB mediante una función serverless y cuenta con pruebas automatizadas.",
    technologies: [
      "React",
      "TypeScript",
      "REST API",
      "Jest",
      "Vercel",
    ],
    image: "/projects/flick-preview.png",
    demo: "https://flick-six-zeta.vercel.app/",
    github: "https://github.com/RocioLV/FLICK",
    featured: true,
  },
  {
    title: "delRocío Artist",
    category: "FRONTEND · CREATIVE PORTFOLIO",
    description:
      "Portafolio artístico interactivo con una interfaz minimalista, galería responsive, filtros por técnica, modales de obras y animaciones de navegación.",
    technologies: [
      "React",
      "TypeScript",
      "Vite",
      "CSS",
    ],
    image: "/projects/delrocio-preview.png",
    demo: "https://rociolv.github.io/delrocio-artist/",
    github: "https://github.com/RocioLV/delrocio-artist",
    featured: true,
  },
  {
    title: "AWS CloudFormation — VPC & EC2",
    category: "CLOUD · INFRASTRUCTURE AS CODE",
    description:
      "Laboratorio de infraestructura como código con CloudFormation. Aprovisionamiento de una VPC, subred privada, Internet Gateway, Security Group e instancia EC2, con documentación técnica.",
    technologies: [
      "AWS",
      "CloudFormation",
      "EC2",
      "VPC",
      "YAML",
    ],
    github: "https://github.com/RocioLV/aws-cloudformation-vpc-ec2",
    featured: true,
  },
  {
    title: "Instituto Milenio Fundamentos de los Datos",
    category: "WEB DEVELOPMENT · WORDPRESS",
    description:
      "Desarrollo e implementación de un sitio institucional en WordPress, con estructuras de contenido personalizadas, plantillas, diseño responsive y mejoras de accesibilidad.",
    technologies: [
      "WordPress",
      "PHP",
      "ACF",
      "CSS",
    ],
    image: "/projects/imfd-preview.png",
    demo: "https://imfd.cl/",
  },
  {
    title: "Clínica Sinapsis",
    category: "WEB DEVELOPMENT · WORDPRESS",
    description:
      "Implementación de un sitio web para una clínica de rehabilitación integral, con presentación de servicios, diseño responsive e integración de reservas.",
    technologies: [
      "WordPress",
      "Responsive",
      "SEO",
    ],
    image: "/projects/sinapsis-preview.png",
    demo: "https://sinapsisrehabilitacion.com",
  },
];

const otherProjects = [
  {
    title: "Social Network — re+",
    description: "Aplicación web de red social desarrollada como proyecto de formación.",
    github: "https://github.com/RocioLV/DEV010-social-network",
  },
  {
    title: "Data Lovers — Studio Ghibli",
    description: "Exploración, filtrado y visualización de datos.",
    github: "https://github.com/RocioLV/DEV010-data-lovers",
  },
  {
    title: "Text Analyzer",
    description: "Herramienta web de análisis y métricas de texto.",
    github: "https://github.com/RocioLV/Text-analyzer",
  },
];
---

<div class="projects-section">
  <div class="projects-intro">
    <p>
      Una selección de proyectos donde combino
      desarrollo Frontend, integración de servicios,
      diseño web e infraestructura Cloud.
    </p>
  </div>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <article
          class:list={[
            "project-card",
            { "project-featured": project.featured },
          ]}
        >
          <div class="project-visual">
            {project.image ? (
              <img
                src={project.image}
                alt={`Vista previa del proyecto ${project.title}`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div
                class:list={[
                  "project-placeholder",
                  {
                    "placeholder-art":
                      project.title.includes("delRocío"),
                    "placeholder-cloud":
                      project.title.includes("CloudFormation"),
                  },
                ]}
                aria-hidden="true"
              >
                <span class="placeholder-mark">
                  {project.title.includes("CloudFormation")
                    ? "AWS / IaC"
                    : "delRocío"}
                </span>
              </div>
            )}
          </div>

          <div class="project-body">
            <p class="project-category">
              {project.category}
            </p>

            <h3>{project.title}</h3>

            <p class="project-description">
              {project.description}
            </p>

            <div class="project-tags">
              {project.technologies.map((technology) => (
                <TechBadge name={technology} />
              ))}
            </div>

            <div class="project-links">
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver demo de ${project.title}`}
                >
                  <span aria-hidden="true">↗</span>
                  Ver proyecto
                </a>
              )}

              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver repositorio de ${project.title}`}
                >
                  <span aria-hidden="true">⌘</span>
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="other-projects">
    <div class="other-heading">
      <h3>Otros proyectos</h3>
      <p>Proyectos realizados durante mi formación en desarrollo web.</p>
    </div>

    <div class="other-grid">
      {
        otherProjects.map((project) => (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="other-card"
          >
            <div>
              <h4>{project.title}</h4>
              <p>{project.description}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .projects-section {
    color: #f0eafe;
  }

  .projects-intro {
    max-width: 670px;
    margin-bottom: 30px;
  }

  .projects-intro p {
    color: #bfb4cd;
    font-size: 0.97rem;
    line-height: 1.75;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(185, 152, 231, 0.15);
    border-radius: 18px;
    background: rgba(36, 27, 50, 0.74);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(185, 152, 231, 0.42);
  }

  .project-visual {
    height: 230px;
    overflow: hidden;
    background: #302044;
  }

  .project-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.35s ease;
  }

  .project-card:hover .project-visual img {
    transform: scale(1.035);
  }

  .project-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(
        ellipse at 75% 25%,
        rgba(255, 130, 91, 0.32),
        transparent 45%
      ),
      linear-gradient(135deg, #302044, #191423);
  }

  .placeholder-art {
    background:
      radial-gradient(
        ellipse at 30% 30%,
        rgba(255, 195, 160, 0.55),
        transparent 40%
      ),
      linear-gradient(135deg, #6a427f, #302044);
  }

  .placeholder-cloud {
    background:
      radial-gradient(
        ellipse at 70% 25%,
        rgba(145, 98, 207, 0.5),
        transparent 48%
      ),
      linear-gradient(135deg, #171827, #302044);
  }

  .placeholder-mark {
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 750;
    letter-spacing: -0.055em;
  }

  .project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px;
  }

  .project-category {
    margin-bottom: 11px;
    color: #ff997b;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .project-body h3 {
    margin: 0 0 13px;
    color: #f0eafe;
    font-size: clamp(1.12rem, 2vw, 1.42rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .project-description {
    margin-bottom: 22px;
    color: #c3b9d0;
    font-size: 0.86rem;
    line-height: 1.75;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .project-tags span {
    padding: 6px 9px;
    border: 1px solid rgba(185, 152, 231, 0.2);
    border-radius: 5px;
    color: #cbb7e4;
    font-size: 0.69rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
    padding-top: 17px;
    border-top: 1px solid rgba(240, 234, 254, 0.1);
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #f0eafe;
    font-size: 0.81rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-links a:hover {
    color: #ff997b;
  }

  .other-projects {
    margin-top: 76px;
  }

  .other-heading {
    margin-bottom: 20px;
  }

  .other-heading h3 {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .other-heading p {
    margin-top: 7px;
    color: #b4a8c4;
    font-size: 0.86rem;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .other-card {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    padding: 22px;
    border: 1px solid rgba(185, 152, 231, 0.13);
    border-radius: 12px;
    background: rgba(145, 98, 207, 0.06);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .other-card:hover {
    border-color: rgba(255, 130, 91, 0.45);
  }

  .other-card h4 {
    color: #f0eafe;
    font-size: 0.9rem;
    font-weight: 650;
  }

  .other-card p {
    margin-top: 9px;
    color: #aca0bd;
    font-size: 0.77rem;
    line-height: 1.6;
  }

  .other-card > span {
    color: #ff825b;
    font-size: 1.2rem;
  }

  .projects-section a:focus-visible {
    outline: 2px solid #ff825b;
    outline-offset: 4px;
    border-radius: 5px;
  }

  @media (max-width: 800px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .other-grid {
      grid-template-columns: 1fr;
    }

    .project-visual {
      height: 250px;
    }
  }

  @media (max-width: 480px) {
    .project-body {
      padding: 20px;
    }

    .project-visual {
      height: 190px;
    }

    .other-projects {
      margin-top: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-visual img,
    .other-card {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover .project-visual img {
      transform: none;
    }
  }
</style>
